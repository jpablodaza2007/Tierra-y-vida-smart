# Producción: copia este archivo como .env y reemplaza todos los valores.
DEPLOYMENT=True
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DATABASE_URL=postgresql://user:password@database-host:5432/tierra_y_vida_smart
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
DEFAULT_FROM_EMAIL=Tierra y Vida Smart <your-gmail-address@gmail.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com
ADMIN_NOTIFICATION_NAME=Administrador
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
GEMINI_API_KEY=
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
